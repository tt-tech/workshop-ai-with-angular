{
  "name": "@atlas/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve atlas",
    "assistant:api": "nx build assistant-api && ANTHROPIC_API_KEY=\"$(security find-generic-password -s anthropic-api-key -w)\" OPENAI_API_KEY=\"$(security find-generic-password -s openai-api-key -w)\" node dist/apps/assistant-api/main.mjs",
    "assistant:api:own-key": "nx build assistant-api && ATLAS_SHOW_TRACE=1 node dist/apps/assistant-api/main.mjs",
    "assistant:api:fake": "nx build assistant-api && ATLAS_MODEL=fake ATLAS_SHOW_TRACE=1 node dist/apps/assistant-api/main.mjs",
    "build": "nx build atlas",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:arch": "nx run-many -t lint --skip-nx-cache && node scripts/scan-secrets.mjs && node scripts/check-tokens.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint:arch:sheriff": "sheriff list && sheriff verify",
    "typecheck": "tsc -p apps/atlas/tsconfig.app.json --noEmit && tsc -p apps/assistant-api/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "graph": "nx graph"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^23.2.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.0",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "~22.1.0",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/angular": "~1.8.9",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/angular": "0.14.0",
    "@a2ui/web_core": "0.15.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@angular/upgrade": "~22.1.0",
    "@anthropic-ai/sdk": "1.3.0",
    "angular": "1.8.3",
    "openai": "7.45.1",
    "rxjs": "~7.8.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@a2ui/angular": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/platform-browser": "$@angular/platform-browser"
    }
  }
}
